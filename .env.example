# AcademiaTrack — Semantic Layer (optional; defaults work for local Ollama dev)
#
# Disable entirely:
#   SEMANTIC_ENABLED=0          # Python sidecar + npm run dev auto-start
#   VITE_SEMANTIC_ENABLED=0     # Frontend default (Settings → AI can still override)

# Sidecar HTTP bind (must match services/ai/semanticBridge DEFAULT_SEMANTIC_BASE_URL)
SEMANTIC_SERVER_HOST=127.0.0.1
SEMANTIC_SERVER_PORT=8765

# Cache / routing tunables (Python sidecar — see semantic_layer/config.py)
# SEMANTIC_SIMILARITY_THRESHOLD=0.90
# SEMANTIC_SMALL_MODEL_ID=llama3.2:1b
# SEMANTIC_LARGE_MODEL_ID=llama3.1:8b
# SEMANTIC_EMBEDDING_DEVICE=cpu

# Ollama backend used by the sidecar when routing misses cache
# SEMANTIC_OLLAMA_BASE_URL=http://localhost:11434

# Optional: Python executable for dev sidecar (default: .venv-semantic/bin/python or python3)
# SEMANTIC_PYTHON=python3
