{
  "name": "academia-track",
  "private": true,
  "version": "5.7.0",
  "description": "Academic Application Tracker - Track universities, programs, deadlines, and submissions",
  "author": "BHARATH CHANDRA VADDARAM <bharath.vbcr@gmail.com>",
  "homepage": "https://github.com/bharathvbcr/AcademiaTrack",
  "repository": {
    "type": "git",
    "url": "https://github.com/bharathvbcr/AcademiaTrack.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20 <26"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "ci:local": "bun run check:version && bun run typecheck && bun run test:run && bun run map:verify && bun run build",
    "map:verify": "node scripts/verify-map-coverage.js",
    "map:status": "devmap status --json && bun run map:verify",
    "map:refresh": "devmap build --manifest && bun run graphify:hook-status && bun run map:verify",
    "graphify:hook-status": "graphify hook status",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "semantic:serve": "SEMANTIC_ENABLED=1 .venv-semantic/bin/python -m semantic_layer.server 2>/dev/null || SEMANTIC_ENABLED=1 python3 -m semantic_layer.server",
    "semantic:test": ".venv-semantic/bin/python -m pytest tests/test_semantic_layer.py tests/test_semantic_server.py -q 2>/dev/null || python3 -m pytest tests/test_semantic_layer.py tests/test_semantic_server.py -q",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "check:version": "node scripts/check-version-consistency.cjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "package": "bun run build:tauri",
    "preview": "vite preview",
    "dev:desktop": "bun run dev:tauri",
    "build:desktop": "bun run build:tauri",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "build:mac": "tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@hello-pangea/dnd": "^18.0.1",
    "@tauri-apps/api": "^2.12.1",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "material-symbols": "^0.45.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.3.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "jsdom": "^27.4.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "vite": "^6.4.2",
    "vitest": "^4.0.16"
  }
}
